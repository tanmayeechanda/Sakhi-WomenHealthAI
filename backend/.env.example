# Copy this file to .env and fill in the values. Never commit .env.

# MongoDB connection string (MongoDB Atlas → Connect → Drivers)
MONGO_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/womenhealth?retryWrites=true&w=majority

# Long random string used to sign login tokens.
# Generate one with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# Port for the API (frontend expects 4000)
PORT=4000

# Where the frontend runs (used in password-reset email links)
FRONTEND_URL=http://localhost:3000

# Google sign-in: OAuth client ID from Google Cloud Console (must match the frontend's)
GOOGLE_CLIENT_ID=

# Optional: Gmail address + 16-character Gmail App Password for reset emails.
# If left empty, reset links are printed in the backend console instead.
EMAIL_USER=
EMAIL_PASS=
